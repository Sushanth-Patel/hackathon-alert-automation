# Telegram Bot Configuration (Required for alerts)
# Create your bot via BotFather: username "HackathonAlert_bot", display name "Hackathon Alert Automation"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Gemini API Key (Optional but recommended for AI enrichment, falls back to regex parser if missing)
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP Add-on (Optional, disabled by default in config.yaml)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com
